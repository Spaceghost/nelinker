-- PE32+ images for the x86-64 UEFI application loader. Input section
-- destinations are RVAs. File offsets match them until the zero-fill tail.
require 'algorithm'
require 'sequence'
require 'memory'

local pe = @record{}
local PAGE: integer <comptime> = 4096
local LIMIT: integer <comptime> = 0x7fffffff
local function aligned(n: integer): integer return (n+PAGE-1) & ~(PAGE-1) end

local function put(out: *sequence(byte), off: integer, value: uint64, width: integer)
  for i = 0, <width do
    ($out)[off+i+1] = (@byte)(value & 255)
    value = value >> 8
  end
end

local function append(out: *sequence(byte), value: integer, width: integer)
  for i = 0, <width do
    out:push((@byte)(value & 255))
    value = value >> 8
  end
end

-- Each block covers one 4 KiB page. GOT references can share a slot; a
-- single DIR64 entry rebases the slot regardless of its reference count.
local function relocations(places: *sequence(integer), text: integer): (sequence(byte), boolean)
  local blocks: sequence(byte)
  local page = -1
  local previous = -8
  local header = 0
  algorithm.heapsort($places)
  for i: usize=1,#$places do
    local place = ($places)[i]
    if place == previous then continue end
    if place < previous+8 then return blocks,false end
    previous=place
    local base=place & ~(PAGE-1)
    if base~=page then
      if page >= 0 then
        if #blocks % 4 ~= 0 then append(&blocks,0,2) end
        put(&blocks,header+4,#blocks-header,4)
      end
      page=base; header=(@integer)(#blocks)
      append(&blocks,page,4); append(&blocks,0,4)
    end
    append(&blocks,0xa000 | (place-page),2) -- IMAGE_REL_BASED_DIR64
  end
  if page < 0 then
    -- A fully PC-relative executable needs no address changes. An empty
    -- relocation block tells firmware that the image is relocatable.
    append(&blocks,text,4); append(&blocks,8,4)
  else
    if #blocks % 4 ~= 0 then append(&blocks,0,2) end -- IMAGE_REL_BASED_ABSOLUTE padding
    put(&blocks,header+4,#blocks-header,4)
  end
  return blocks,true
end

local function section(out: *sequence(byte), pos: integer, name: string, rva: integer,
                       size: integer, raw: integer, rawsize: integer, flags: integer): integer
  memory.copy(&($out)[pos+1],name.data,#name)
  put(out,pos+8,size,4); put(out,pos+12,rva,4); put(out,pos+16,rawsize,4)
  put(out,pos+20,raw,4); put(out,pos+36,flags,4)
  return pos+40
end

function pe.finish(out: *sequence(byte), places: *sequence(integer), base: integer, entry: integer,
                   ro_end: integer, text: integer, text_end: integer, data: integer,
                   data_end: integer, mem_end: integer): string
  local blocks, valid = relocations(places,text)
  if not valid then return 'overlapping PE base relocation fields' end
  local reloc_rva=aligned(mem_end)
  local reloc_raw=aligned((@integer)(#$out))
  local file_size=reloc_raw+aligned((@integer)(#blocks))
  local image_size=reloc_rva+aligned((@integer)(#blocks))
  if image_size>LIMIT or file_size>LIMIT then return 'PE image exceeds supported range' end
  out:resize((@usize)(file_size))
  memory.copy(&($out)[reloc_raw+1],&blocks[1],#blocks)

  local readonly=ro_end>PAGE
  local writable=mem_end>data
  local count=2+(readonly and 1 or 0)+(writable and 1 or 0)
  local code_size=aligned(text_end-text)
  local data_size=aligned(data_end-data)
  local ro_size=aligned(ro_end-PAGE)
  -- Minimal DOS header, PE signature and COFF file header.
  put(out,0,0x5a4d,2); put(out,0x3c,0x80,4); put(out,0x80,0x4550,4)
  put(out,0x84,0x8664,2); put(out,0x86,count,2); put(out,0x94,240,2)
  put(out,0x96,0x22,2) -- executable, large-address-aware
  local opt=0x98
  put(out,opt,0x20b,2)
  put(out,opt+4,code_size,4); put(out,opt+8,ro_size+data_size+aligned((@integer)(#blocks)),4)
  put(out,opt+12,mem_end-data_end,4)
  put(out,opt+16,entry-base,4); put(out,opt+20,text,4); put(out,opt+24,base,8)
  put(out,opt+32,PAGE,4); put(out,opt+36,PAGE,4)
  put(out,opt+48,2,2) -- subsystem version
  put(out,opt+56,image_size,4); put(out,opt+60,PAGE,4)
  put(out,opt+68,10,2); put(out,opt+70,0x140,2) -- EFI application, dynamic base and NX
  put(out,opt+72,0x100000,8); put(out,opt+80,PAGE,8)
  put(out,opt+88,0x100000,8); put(out,opt+96,PAGE,8)
  put(out,opt+108,16,4)
  put(out,opt+152,reloc_rva,4); put(out,opt+156,#blocks,4)
  local pos=opt+240
  if readonly then
    pos=section(out,pos,'.rdata',PAGE,ro_end-PAGE,PAGE,ro_size,0x40000040)
  end
  pos=section(out,pos,'.text',text,text_end-text,text,code_size,0x60000020)
  if writable then
    if data_size==0 then
      pos=section(out,pos,'.bss',data,mem_end-data,0,0,0xc0000080)
    else
      pos=section(out,pos,'.data',data,mem_end-data,data,data_size,0xc0000040)
    end
  end
  section(out,pos,'.reloc',reloc_rva,(@integer)(#blocks),reloc_raw,aligned((@integer)(#blocks)),0x42000040)
  return ''
end

return pe
